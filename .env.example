# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# TWILIO SMS API CONFIGURATION
# Configure these to dispatch real SMS messages to customer mobile phones.
# If omitted, the app simulates delivery and records full logs smoothly.
# ==============================================================================
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ==============================================================================
# EMAIL NOTIFICATIONS CONFIGURATION (EMAILJS / SMTP NODEMAILER)
# Configure EmailJS or SMTP credentials to deliver real booking confirmation emails.
# ==============================================================================
# Option A: EmailJS
EMAILJS_SERVICE_ID="service_quepasa"
EMAILJS_TEMPLATE_ID="template_booking_confirm"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"

# Option B: SMTP (Nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="reservas@quepasa.pt"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Qué Pasa <reservas@quepasa.pt>"

# ==============================================================================
# BREVO (SENDINBLUE) ALL-IN-ONE EMAIL & SMS
# You can set these in .env or directly in the Admin Panel -> Configurações -> Brevo
# ==============================================================================
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="reservas@quepasa.pt"
BREVO_SENDER_NAME="Qué Pasa · Aveiro"
BREVO_SMS_SENDER="QuePasa"
